// Deployed by `make site-deploy` from the repo root, which pins the wrangler
// version in the Makefile and polls /health afterwards. `make site-rollback`
// undoes a deploy. The site is a single Worker, so there is nothing else to
// configure.
{
  "name": "toktop-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Default is assets-first: /dashboard.png would skip the Worker, so
    // cache headers, 405s, and HSTS in worker.js would never apply.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "toktop.ai", "custom_domain": true },
    { "pattern": "www.toktop.ai", "custom_domain": true }
  ],
  // Invocation logs off. With them on, Workers Logs records every request
  // with the visitor's IP address and user agent, which is the only personal
  // data this project collects and the one line the site never needed: the
  // Worker reports nothing back, so a request log says only that a request
  // worked. The console lines the Worker writes about its own failures stay,
  // and they carry a ray, a method and a path rather than the client. This is
  // what docs/PRIVACY.md and site/README.md describe.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
