// Linter for the Cloudflare Worker in site/. That is the only JavaScript in
// the repo, and it shipped with no analyzer at all, so the edge code that sets
// every response header ran unchecked. The version pin lives in the Makefile
// (BIOME), which CI and `make site-lint` both read, so a local run and a remote
// run cannot pick different rule sets.
{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["site/**/*.js"] },
  // Hand-formatted at two spaces. No formatter has ever rewritten these files,
  // so turning one on now would be a whole-tree reformat, not a gate. Lint is
  // the part that catches defects; formatting stays a reviewer's eye.
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      // The preset alone is Biome's default set, which leaves the correctness,
      // a11y, suspicious and security groups largely unrun. Those are the
      // groups that catch a bad header, a bad status, a misused async call, a
      // loose null comparison, or a leaked key in edge code, and the tree
      // passes all four today.
      "preset": "recommended",
      "a11y": "error",
      "suspicious": "error",
      "security": "error",
      // In the correctness group but assumes a Qwik app, which this is not:
      // useQwikValidLexicalScope flags every ordinary closure capture. There is
      // no Qwik build here for the rule to be right about.
      "correctness": { "useQwikValidLexicalScope": "off" },
      // complexity, performance, style and nursery stay off: the tree does not
      // pass them today (cognitive-complexity on the representation picker,
      // await-in-loop in the image tests, magic numbers in the FNV hash), and
      // those are refactors rather than defects to gate on.
    },
  },
  "overrides": [
    {
      // worker.test.js runs under bun, not workerd, and is never deployed, so
      // a node: import there is a test harness detail, not a bundle-bloat
      // defect.
      "includes": ["site/worker.test.js"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } },
    },
  ],
}
