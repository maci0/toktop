// Linter for the Cloudflare Worker in site/. That is the only JavaScript in
// the repo, and it shipped with no analyzer at all, so the edge code that sets
// every response header ran unchecked. The version pin lives in the Makefile
// (BIOME), which CI and `make site-lint` both read, so a local run and a remote
// run cannot pick different rule sets. `make site-lint` fails when the version
// here and the BIOME_VERSION it pins disagree, so a bump that moved only one of
// the two does not land.
{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  // The jsonc entries are the site config and this file: they are the only
  // other files biome can check, and both were being formatted by hand with
  // no gate over them.
  "files": { "includes": ["site/**/*.js", "site/**/*.jsonc", "*.jsonc"] },
  // Two-space indent, as the worker has always been written. lineWidth 100 is
  // the width the tree already lives at: every line past it is embedded markup,
  // a long literal, or a biome-ignore comment, none of which a formatter
  // breaks. `make site-lint` runs `biome check`, so this is a gate, not a
  // suggestion.
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      // The preset alone is Biome's default set, which leaves the correctness,
      // a11y, suspicious, security and performance groups largely unrun. Those
      // are the groups that catch a bad header, a bad status, a misused async
      // call, a loose null comparison, a leaked key in edge code, or a
      // per-request regex, and the tree passes all of them today. The
      // worker's regexes are module constants for the last one: a literal
      // inside a handler is recompiled on every request. Complexity and
      // performance are named here too; the rules that measure size are
      // scoped off below, with the reason.
      "preset": "recommended",
      "a11y": "error",
      "suspicious": "error",
      "security": "error",
      "performance": "error",
      // In the correctness group but assumes a Qwik app, which this is not:
      // useQwikValidLexicalScope flags every ordinary closure capture. There is
      // no Qwik build here for the rule to be right about.
      "correctness": { "useQwikValidLexicalScope": "off" },
      // Complexity is on; three of its rules are off because they measure the
      // size of the request handler, not its shape. handle() is the whole
      // routing table plus the body encoders (cognitive complexity 43, 114
      // lines) and failRequest() takes the status, event, body and extra
      // headers of a failure answer as named arguments. Splitting either is a
      // refactor, and a size threshold is not a defect finding.
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "useMaxParams": "off"
      },
      // One style rule on its own, not the group. The rest of style stays off
      // because the tree does not pass it (noContinue in the encoding parser,
      // useBlockStatements on the one-line early returns, noMagicNumbers in
      // the ANSI palette and the FNV hash, noTernary, noIncrementDecrement,
      // useNumericSeparators, noExcessiveLinesPerFile), and those are rewrites
      // of code that is already shaped the way the author wants it. Nursery
      // stays off for the same reason plus one of its own: its rules change
      // without a major bump, so a gate on them is a gate on a moving target.
      // A template literal with no interpolation is a string that reads as
      // markup, where a stray `${` would be the mistake, and the tree passes
      // that one.
      "style": { "noUnusedTemplateLiteral": "error" }
    }
  },
  "overrides": [
    {
      // worker.test.js runs under bun, not workerd, and is never deployed, so
      // a node: import there is a test harness detail, not a bundle-bloat
      // defect. The awaits are the same: each case sets up a fake asset store
      // and reads the answer before the next one replaces it, so the
      // sequential await is what makes the assertions independent.
      "includes": ["site/worker.test.js"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "performance": { "noAwaitInLoops": "off" }
        }
      }
    }
  ]
}
